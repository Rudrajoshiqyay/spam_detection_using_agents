# ============================================================
# FraudGuard AI — Environment Configuration
# Copy this file to .env and fill in real values.
# ============================================================

# ----------------------------------------------------------
# LLM (Groq — groq.com)
# ----------------------------------------------------------
GROQ_API_KEY=gsk_...                     # Required when MOCK_LLM=false
FAST_MODEL=llama-3.1-8b-instant          # Parallel analysis agents
DEEP_MODEL=llama-3.3-70b-versatile       # Investigation & storytelling
MOCK_LLM=false                           # true = use deterministic mock (demo/tests)

# ----------------------------------------------------------
# Redis (Upstash recommended)
# ----------------------------------------------------------
REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://<host>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>
USE_FAKE_REDIS=false                     # true = in-memory fallback (dev/tests only)

# ----------------------------------------------------------
# Database (Neon PostgreSQL recommended for production)
# ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:pass@host/db

# ----------------------------------------------------------
# Security
# ----------------------------------------------------------
API_KEY=                                 # Set a strong random string to enable auth
                                         # Leave empty to disable auth (dev mode)
CORS_ALLOWED_ORIGINS=                    # Comma-separated: https://your-app.vercel.app

# ----------------------------------------------------------
# Detection thresholds
# ----------------------------------------------------------
FAST_SCREENING_THRESHOLD=35              # Below = auto-approve
HIGH_RISK_THRESHOLD=70                   # Above = auto-block in screening

# ----------------------------------------------------------
# Observability
# ----------------------------------------------------------
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR
APP_ENV=production                       # development | production
